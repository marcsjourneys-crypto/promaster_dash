{
  "expo": {
    "name": "ProMaster Dash",
    "slug": "promaster-dash",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/PD.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/PD.png",
      "resizeMode": "contain",
      "backgroundColor": "#161410"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "4",
      "bundleIdentifier": "com.promasterdash.app",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "ProMaster Dash uses your location to track trips and display speed, heading, and elevation.",
        "NSLocationWhenInUseUsageDescription": "ProMaster Dash uses your location to display speed, heading, and elevation.",
        "NSBluetoothAlwaysUsageDescription": "ProMaster Dash connects to your VLinker OBD2 adapter via Bluetooth to read vehicle data.",
        "UIBackgroundModes": [
          "location",
          "bluetooth-central"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.promasterdash.app",
      "adaptiveIcon": {
        "backgroundColor": "#161410",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "neverForLocation": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ProMaster Dash uses your location to track trips and display speed, heading, and elevation.",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "e704632f-cd61-44a1-a107-f225b67574f9"
      }
    }
  }
}
